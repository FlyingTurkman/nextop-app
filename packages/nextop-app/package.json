{
  "name": "nextop-app",
  "version": "1.1.0",
  "description": "The fullstack React framework for the desktop — a live Next.js server inside an Electron shell. Hooks, secure IPC, and the nextop CLI.",
  "keywords": [
    "nextjs",
    "electron",
    "desktop",
    "react",
    "ssr",
    "framework",
    "nextop"
  ],
  "license": "MIT",
  "homepage": "https://nextopapp.vercel.app",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "bin": {
    "nextop": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FlyingTurkman/nextop-app",
    "directory": "packages/nextop-app"
  },
  "bugs": {
    "url": "https://github.com/FlyingTurkman/nextop-app/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "import": "./dist/main/index.js",
      "require": "./dist/main/index.js"
    },
    "./link": {
      "types": "./dist/link/index.d.ts",
      "import": "./dist/link/index.js"
    },
    "./virtual-list": {
      "types": "./dist/virtual-list/index.d.ts",
      "import": "./dist/virtual-list/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "peerDependencies": {
    "next": "^16.1.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "next": "^16.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.9.3"
  }
}
