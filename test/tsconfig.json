{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2020",
    "types": [],
    "lib": [
      "ES2020",
      "DOM"
    ],
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "skipDefaultLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "main.ts",
    "preload.ts",
    "window.ts",
    "types.ts",
    "types.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "electron/**/*.ts",
    "electron/startNext.ts",
    "**/*.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
