{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "rootDir": ".",
    "outDir": "../dist/electron",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "types": ["node", "electron"],
    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
